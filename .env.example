# Public frontend values (safe to expose)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Sanity Studio values (also public; Sanity requires this prefix in Studio)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# No API token is required for local seed/migration commands.
# Run `npx sanity login` once; the scripts use your authenticated Sanity CLI session.
