---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import ArtworkLightbox from '../components/ArtworkLightbox.astro';
import ProgramCard from '../components/ProgramCard.astro';
import TuitionCards from '../components/TuitionCards.astro';
import { getArtwork, getPrograms, getSiteSettings, getPrimaryTuition } from '../lib/content';

const [allArtwork, programs, settings, tuition] = await Promise.all([
  getArtwork(),
  getPrograms(),
  getSiteSettings(),
  getPrimaryTuition(),
]);
const featuredArtwork = allArtwork.filter((item) => item.featured);
const artwork = (featuredArtwork.length ? featuredArtwork : allArtwork).slice(0, 6);
const heroFallback = allArtwork.slice(0, 4);
const heroPoolJson = JSON.stringify(allArtwork.map((item) => ({
  image: item.image,
  alt: item.alt || `${item.title} by ${item.student}`,
}))).replace(/</g, '\\u003c');
const primaryProgram = programs.find((program) => program.primaryProgram) || programs[0];
const secondaryPrograms = programs.filter((program) => program.id !== primaryProgram?.id);
---
<BaseLayout>
  <section class="home-intro section-pad">
    <div class="home-intro-copy">
      <h1>Liang Art Studio</h1>
      <p class="home-tagline">{settings.tagline}</p>
      <div class="button-row">
        <a class="button primary" href="/gallery">Student Gallery</a>
        <a class="button secondary" href="/tuition">Tuition Rates</a>
      </div>
    </div>
    <div class="home-art-grid" aria-label="Student artwork spotlight">
      {heroFallback.map((item, index) => (
        <img class={`home-art home-art-${index + 1}`} data-home-art src={item.image} alt={item.alt || item.title} />
      ))}
    </div>
    <script is:inline id="home-art-pool" type="application/json" set:html={heroPoolJson}></script>
  </section>

  <section class="section-pad gallery-feature">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">Gallery</p>
        <h2>Student Gallery</h2>
        <p>{settings.galleryIntro}</p>
      </div>
      <a class="text-link" href="/gallery">View full gallery <span>↗</span></a>
    </div>
    <div class="masonry-grid featured-grid">
      {artwork.map((item) => <ArtworkCard artwork={item} lightbox={true} />)}
    </div>
  </section>

  <section class="section-pad programs-preview">
    <div class="section-heading split-heading">
      <div><p class="eyebrow">Classes</p><h2>Programs</h2></div>
      <a class="text-link" href="/programs">View programs <span>↗</span></a>
    </div>
    <div class="program-grid">
      {primaryProgram && <ProgramCard program={primaryProgram} prominent={true} />}
      {secondaryPrograms.map((program) => <ProgramCard program={program} />)}
    </div>
  </section>



  <ArtworkLightbox />

  <script>
    const poolNode = document.querySelector('#home-art-pool');
    const heroImages = [...document.querySelectorAll('[data-home-art]')];

    if (poolNode && heroImages.length) {
      try {
        const pool = JSON.parse(poolNode.textContent || '[]');
        for (let i = pool.length - 1; i > 0; i -= 1) {
          const j = Math.floor(Math.random() * (i + 1));
          [pool[i], pool[j]] = [pool[j], pool[i]];
        }
        heroImages.forEach((image, index) => {
          const item = pool[index];
          if (!item) return;
          image.setAttribute('src', item.image);
          image.setAttribute('alt', item.alt || 'Student artwork');
        });
      } catch (error) {
        console.warn('Unable to rotate homepage artwork.', error);
      }
    }
  </script>

  <section class="tuition-section section-pad">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">{tuition.program} · {tuition.term}</p>
        <h2>Tuition Rates</h2>
        {tuition.classCount && <p>All plans include {tuition.classCount} total classes for the semester.</p>}
      </div>
      <a class="text-link" href="/tuition">Full tuition details <span>↗</span></a>
    </div>
    <TuitionCards tuition={tuition} compact={true} />
  </section>
</BaseLayout>
