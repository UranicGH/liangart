---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import ArtworkLightbox from '../components/ArtworkLightbox.astro';
import { getArtwork, getSiteSettings } from '../lib/content';

const [artwork, settings] = await Promise.all([getArtwork(), getSiteSettings()]);
const programs = ['All', ...new Set(artwork.map((item) => item.program).filter(Boolean))];
const categories = ['All', ...new Set(artwork.map((item) => item.category).filter(Boolean))];
const hasAges = artwork.some((item) => typeof item.ageAtCompletion === 'number');
---
<BaseLayout title="Student Gallery" description={settings.galleryIntro}>
  <section class="page-intro section-pad compact-intro">
    <p class="eyebrow">Gallery</p>
    <h1>Student Gallery</h1>
    <p>{settings.galleryIntro}</p>
  </section>

  <section class="section-pad gallery-page">
    {programs.length > 2 && (
      <div class="filter-group">
        <span class="filter-label">Program</span>
        <div class="filter-bar" role="group" aria-label="Filter student work by program">
          {programs.map((program, index) => <button class:list={{ 'filter-chip': true, active: index === 0 }} data-program-filter={program}>{program}</button>)}
        </div>
      </div>
    )}
    <div class="filter-group">
      <span class="filter-label">Awards</span>
      <div class="filter-bar" role="group" aria-label="Filter student work by award status">
        <button class="filter-chip active" data-award-filter="All">All Work</button>
        <button class="filter-chip" data-award-filter="Award Winners">Award Winners</button>
      </div>
    </div>
    {hasAges && (
      <div class="filter-group">
        <span class="filter-label">Age</span>
        <div class="filter-bar" role="group" aria-label="Filter student work by age at completion">
          <button class="filter-chip active" data-age-filter="All">All Ages</button>
          <button class="filter-chip" data-age-filter="under10">Under 10</button>
          <button class="filter-chip" data-age-filter="10-12">10–12</button>
          <button class="filter-chip" data-age-filter="13-15">13–15</button>
          <button class="filter-chip" data-age-filter="16plus">16+</button>
        </div>
      </div>
    )}
    <div class="filter-group">
      <span class="filter-label">Category</span>
      <div class="filter-bar" role="group" aria-label="Filter artwork by category">
        {categories.map((category, index) => <button class:list={{ 'filter-chip': true, active: index === 0 }} data-category-filter={category}>{category}</button>)}
      </div>
    </div>
    <div class="gallery-toolbar">
      <p id="gallery-count" class="gallery-count">Showing {artwork.length} works</p>
      <label class="gallery-sort">
        <span>Sort</span>
        <select id="gallery-sort" aria-label="Sort student work">
          <option value="recent">Most recent</option>
          <option value="oldest">Oldest</option>
          <option value="student">Student A–Z</option>
        </select>
      </label>
    </div>
    <div id="gallery-grid" class="masonry-grid">
      {artwork.map((item) => <ArtworkCard artwork={item} lightbox={true} />)}
    </div>
  </section>

  <ArtworkLightbox />

  <script>
    const programChips = [...document.querySelectorAll<HTMLButtonElement>('[data-program-filter]')];
    const categoryChips = [...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
    const awardChips = [...document.querySelectorAll<HTMLButtonElement>('[data-award-filter]')];
    const ageChips = [...document.querySelectorAll<HTMLButtonElement>('[data-age-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('.art-card')];
    const count = document.querySelector<HTMLElement>('#gallery-count');
    const grid = document.querySelector<HTMLElement>('#gallery-grid');
    const sortSelect = document.querySelector<HTMLSelectElement>('#gallery-sort');
    let programFilter = 'All';
    let categoryFilter = 'All';
    let awardFilter = 'All';
    let ageFilter = 'All';

    const sortCards = () => {
      if (!grid || !sortSelect) return;
      const mode = sortSelect.value;
      const sorted = [...cards].sort((a, b) => {
        if (mode === 'student') {
          return (a.getAttribute('data-student') || '').localeCompare(b.getAttribute('data-student') || '', undefined, { sensitivity: 'base' });
        }
        const aDate = Number(a.getAttribute('data-sort-date') || 0);
        const bDate = Number(b.getAttribute('data-sort-date') || 0);
        return mode === 'oldest' ? aDate - bDate : bDate - aDate;
      });
      sorted.forEach((card) => grid.appendChild(card));
    };

    const applyFilters = () => {
      let visible = 0;
      cards.forEach((card) => {
        const programMatch = programFilter === 'All' || card.getAttribute('data-program') === programFilter;
        const categoryMatch = categoryFilter === 'All' || card.getAttribute('data-category') === categoryFilter;
        const awardMatch = awardFilter === 'All' || card.getAttribute('data-award') === 'true';
        const age = Number(card.getAttribute('data-age') || 0);
        const ageMatch = ageFilter === 'All'
          || (ageFilter === 'under10' && age > 0 && age < 10)
          || (ageFilter === '10-12' && age >= 10 && age <= 12)
          || (ageFilter === '13-15' && age >= 13 && age <= 15)
          || (ageFilter === '16plus' && age >= 16);
        const show = programMatch && categoryMatch && awardMatch && ageMatch;
        card.toggleAttribute('hidden', !show);
        if (show) visible += 1;
      });
      if (count) count.textContent = `Showing ${visible} ${visible === 1 ? 'work' : 'works'}`;
    };

    programChips.forEach((chip) => chip.addEventListener('click', () => {
      programChips.forEach((item) => item.classList.remove('active'));
      chip.classList.add('active');
      programFilter = chip.getAttribute('data-program-filter') || 'All';
      applyFilters();
    }));
    categoryChips.forEach((chip) => chip.addEventListener('click', () => {
      categoryChips.forEach((item) => item.classList.remove('active'));
      chip.classList.add('active');
      categoryFilter = chip.getAttribute('data-category-filter') || 'All';
      applyFilters();
    }));
    awardChips.forEach((chip) => chip.addEventListener('click', () => {
      awardChips.forEach((item) => item.classList.remove('active'));
      chip.classList.add('active');
      awardFilter = chip.getAttribute('data-award-filter') || 'All';
      applyFilters();
    }));
    ageChips.forEach((chip) => chip.addEventListener('click', () => {
      ageChips.forEach((item) => item.classList.remove('active'));
      chip.classList.add('active');
      ageFilter = chip.getAttribute('data-age-filter') || 'All';
      applyFilters();
    }));
    sortSelect?.addEventListener('change', sortCards);
    sortCards();

  </script>
</BaseLayout>
